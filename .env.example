# External APIs
GEMINI_API_KEY=
GEOAPIFY_API_KEY=

# Default incident location for AI prompt context
DEFAULT_LOCATION=Toronto, Ontario, Canada

# --- Database Options (Choose One) ---

# Option A: Neon Cloud Postgres (Default / Production)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Option B: Local Docker Postgres (Uncomment if running via `docker compose up -d`)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=citywatch
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/citywatch

# --- Object Storage Config (boto3) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
AWS_BUCKET_NAME=city-watch-reports
AWS_ENDPOINT_URL_S3=

# Optional Redis Rate Limiting (defaults to in-memory if omitted)
REDIS_URL=